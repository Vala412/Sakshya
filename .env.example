# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real credentials.

# Required for embeddings (text-embedding-3-small) and chat/explanation
# generation (gpt-4o-mini class model).
OPENAI_API_KEY=

# Qdrant, run locally via `docker compose up -d qdrant` (see docker-compose.yml).
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=gst_law_corpus

# Langfuse Cloud (free tier) -- create a project at https://cloud.langfuse.com
# and copy its keys here. Leave blank to run without tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
