__pycache__/
*.pyc
*.egg-info/
.venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
dist/
build/
data/synthetic/
data/qdrant_storage/
# Large binary PDFs + their derived chunks -- both reproducible via
# scripts/fetch_corpus.py + scripts/ingest_corpus.py, not worth versioning.
data/corpus/raw/
data/corpus/chunks.json
*.xlsx
!data/samples/*.xlsx

# Frontend build + dependency output. node_modules is ~140 packages and
# dist/ is regenerated by `make frontend-build`; neither belongs in history.
frontend/node_modules/
frontend/dist/
# `tsc -b` incremental state, regenerated on every build.
frontend/*.tsbuildinfo
frontend/.vite/
frontend/coverage/

# Local agent tooling (downloaded skills, session config). Not project code
# -- the taste-skill copy under here is a third-party MIT-licensed file
# vendored for local use, not something this repo should redistribute.
.claude/
